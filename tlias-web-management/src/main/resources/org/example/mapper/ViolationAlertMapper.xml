<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.ViolationAlertMapper">

    <insert id="insertViolationAlert">
        insert into violation_alert (student_id, student_name,master_id,violation_score,is_read,create_time) values (#{studentId}, #{studentName},#{masterId},#{violationScore},0,#{createTime})
    </insert>

</mapper>